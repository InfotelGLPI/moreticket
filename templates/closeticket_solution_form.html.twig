<div class="spaced" id="moreticket_close_ticket">
    <br>
    <table>
        <tr>
            <td>
                {{ solution_template_label }}&nbsp;:&nbsp;&nbsp;
                {{ solution_template_dropdown|raw }}
                {{ render_twig_hidden|raw }}
                {{ script_block|raw }}
            </td>
        </tr>

        <tr>
            <td>
                {{ solution_type_label }}
                {% if solution_type_mandatory %}&nbsp;:&nbsp;<span class="text-danger">*</span>&nbsp;{% endif %}
                {{ solution_type_dropdown|raw }}
            </td>
        </tr>

        <tr>
            <td>
                {{ solution_desc_label }}&nbsp;:&nbsp;<span class="text-danger">*</span>&nbsp;
                {{ solution_editor|raw }}
            </td>
        </tr>

        {% if use_duration_solution %}
            <tr>
                <td>
                    {{ __('Duration') }}
                    {% if duration_mandatory %}&nbsp;<span class="text-danger">*</span>&nbsp;{% endif %}
                    <span id="{{ duration_span_id }}">{{ duration_dropdown|raw }}</span>
                </td>
            </tr>
        {% endif %}
    </table>
</div>
